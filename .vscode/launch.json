{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug for train detection",
            "type": "debugpy",
            "request": "launch",
            "program": "src/train_detection.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}:${workspaceFolder}/src:${workspaceFolder}/opencood"
            }
        },
        {
        "name": "test for bev",
        "type": "debugpy",
        "request": "launch",
        "program": "src/tests/test_for_bev.py",
        "console": "integratedTerminal",
        "justMyCode": false,
        "cwd": "${workspaceFolder}",
        "env": {
            "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}:${workspaceFolder}/src:${workspaceFolder}/opencood"
        }
    }]
}
